APP_ENV=development
# Comma-separated exact frontend origins. Do not use *.
CORS_ORIGINS=http://127.0.0.1:5173

# Public project configuration used by the backend to validate access tokens.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Never put a Supabase secret/service-role key in frontend files.
# The API uses the student's bearer token for user-scoped operations.
