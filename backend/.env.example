# Supabase project URL used by backend integrations
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only secrets. Never put service-role keys in frontend variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_JWT_SECRET=replace-with-server-side-jwt-verification-secret

# Application settings
APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:5173
