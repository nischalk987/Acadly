# Public Supabase settings. These values are browser-visible; enforce RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_BRAND_NAME=Acadly

# Optional Web Push public VAPID key. The private key must only exist in Supabase Edge Function secrets.
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
